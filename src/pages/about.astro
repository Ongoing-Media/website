---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Photo from '../components/Photo.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../config/site';

import steelRoom from '../assets/images/steel-room.jpg';
import walkingBlur from '../assets/images/walking-blur.jpg';
import chairLaptop from '../assets/images/chair-laptop.jpg';

const worlds = [
  {
    title: 'traditional media',
    text: 'Knowing how stories are told, how attention is earned and how an audience is built when there’s no algorithm to hide behind.',
  },
  {
    title: 'social media',
    text: 'Native to the feed, and fluent in what moves people before it becomes a trend report.',
  },
];
---

<BaseLayout
  title="About us"
  description="Ongoing Media is an Amsterdam-based influencer marketing agency, built out of two worlds: traditional media and social media."
  headerTone="cream"
>
  <PageHero
    tone="cream"
    eyebrow="about us"
    bold="hi! we are"
    italic="ongoing media"
    intro="An Amsterdam-based influencer marketing agency turning behavior into strategy, creators into momentum, and attention into impact."
  />

  <Section tone="white" labelledby="grown-up-heading">
    <div class="container grown-up">
      <div class="prose">
        <SplitHeading id="grown-up-heading" size="xl" bold="the influencer industry" italic="has grown up" />
        <p class="lead">
          People have gotten too good at spotting ads. The moment something feels like marketing, they’re already
          scrolling past it.
        </p>
        <p>
          Marketing has grown up, so you need a partner that helps you find a new road around this. Content that earns its
          place in the feed, and its way into the conversation offline.
        </p>
      </div>
      <div class="photos">
        <Photo src={steelRoom} alt="" sizes="(min-width: 60rem) 20vw, 45vw" class="photo" />
        <Photo src={walkingBlur} alt="" sizes="(min-width: 60rem) 18vw, 40vw" class="photo offset" />
      </div>
    </div>
  </Section>

  <Section tone="plum" labelledby="worlds-heading">
    <div class="container worlds">
      <SplitHeading id="worlds-heading" bold="built out of" italic="two worlds" stacked />
      <ul>
        {
          worlds.map((world) => (
            <li>
              <h3>{world.title}</h3>
              <p>{world.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="lead bridge">
        Together they form the bridge between the media that shaped a generation, and the media that’s shaping the next one.
      </p>
    </div>
  </Section>

  <Section tone="brown" labelledby="beyond-heading">
    <div class="container beyond">
      <div class="prose">
        <SplitHeading id="beyond-heading" size="xl" bold="we move" italic="beyond the feed" />
        <p>
          We don’t just execute influencer collaborations. We develop and run full-scale social media strategies and
          campaigns, where the right people, at the right moment, move culture forward.
        </p>
        <p>
          For content creation and event management we work with trusted partners and hand-picked professionals, so
          everything comes together under one roof.
        </p>
        <p class="based">
          Based at {site.address.street}, {site.address.city}.
        </p>
      </div>
      <Photo src={chairLaptop} alt="A laptop on a white chair in a studio" sizes="(min-width: 60rem) 28vw, 80vw" class="photo beyond-photo" />
    </div>
  </Section>

  <CallToAction />
</BaseLayout>

<style>
  .grown-up,
  .beyond {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .photos :global(.offset) {
    margin-top: 35%;
  }

  :global(.photo) img {
    width: 100%;
    height: auto;
  }

  .worlds {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .worlds ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .worlds li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--line);
  }

  .worlds h3 {
    font-size: var(--text-xl);
    color: var(--accent);
  }

  .bridge {
    max-width: 30ch;
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .based {
    color: var(--muted);
    font-style: italic;
  }

  .beyond :global(.beyond-photo) {
    width: min(100%, 24rem);
    justify-self: end;
  }

  @media (min-width: 48rem) {
    .worlds ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 60rem) {
    .grown-up,
    .beyond {
      grid-template-columns: 1.3fr 1fr;
    }
  }
</style>
