---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SplitHeading from '../components/SplitHeading.astro';
import PillarGrid from '../components/PillarGrid.astro';
import OnRepeat from '../components/OnRepeat.astro';
import CallToAction from '../components/CallToAction.astro';
import { channels, processSteps } from '../data/services';
---

<BaseLayout
  title="What we do"
  description="Strategy, campaigns and data, on repeat. Ongoing Media develops and runs full-scale social media and influencer marketing campaigns."
  headerTone="cream"
>
  <PageHero
    tone="cream"
    eyebrow="what we do"
    bold="we are your"
    italic="partner in"
    intro="A seamless collaboration under one roof: from the first insight to the final report."
  />

  <div class="repeat" data-tone="cream">
    <OnRepeat />
  </div>

  <Section tone="cream" labelledby="pillars-heading">
    <div class="container">
      <h2 id="pillars-heading" class="visually-hidden">Our services</h2>
      <PillarGrid detailed />
    </div>
  </Section>


  <Section tone="brown" labelledby="channels-heading">
    <div class="container channels-grid">
      <div class="channels-intro">
        <SplitHeading id="channels-heading" bold="earned, owned" italic="& paid" stacked />
        <p class="lead">We operate across all channels, with the media strategy that fits your objectives.</p>
      </div>
      <ul class="channels">
        {
          channels.map((channel) => (
            <li>
              <h3>{channel.title}</h3>
              <p>{channel.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>


  <Section tone="cream" labelledby="process-heading">
    <div class="container process">
      <SplitHeading id="process-heading" bold="our way" italic="of working" />
      <ol class="steps">
        {
          processSteps.map((step, index) => (
            <li>
              <span class="step-number">({index + 1}.)</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <CallToAction />
</BaseLayout>

<style>
  .repeat {
    padding-bottom: 1rem;
  }


  .channels-grid {
    display: grid;
    gap: 3rem;
  }

  .channels-intro {
    display: grid;
    gap: 1.5rem;
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .channels li {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--line);
  }

  .channels h3 {
    font-size: var(--text-xl);
    color: var(--accent);
  }


  .process {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1.5px solid var(--line);
    border-radius: 1.25rem;
  }

  .step-number {
    font-style: italic;
    color: var(--muted);
  }

  .steps h3 {
    font-size: var(--text-xl);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .channels-grid {
      grid-template-columns: 1fr 1fr;
    }

    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
