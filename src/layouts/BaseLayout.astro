---
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Tone } from '../components/Section.astro';
import { site } from '../config/site';
import { buildPageTitle } from '../lib/pageTitle';
import { absoluteUrl } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Kleur van de eerste sectie; de bovenbalk neemt die over. */
  headerTone?: Tone;
  /** Niet tonen in zoekmachines (bijv. de bedankpagina). */
  noindex?: boolean;
}

const { title, description = site.description, headerTone = 'white', noindex = false } = Astro.props;
const pageTitle = buildPageTitle(site.name, title);
// Pagina's die niet in zoekmachines horen (zoals de 404) krijgen geen eigen officieel adres.
const canonicalUrl = noindex ? undefined : absoluteUrl(Astro.url.pathname, Astro.site!);
const shareImageUrl = absoluteUrl(site.shareImage.path, Astro.site!);

const organization = {
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: absoluteUrl('/icon-512.png', Astro.site!),
  email: site.email,
  sameAs: site.socials.map((social) => social.url),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
};
// "WebSite" vertelt Google welke sitenaam naast het favicon in de zoekresultaten hoort.
const website = { '@type': 'WebSite', name: site.name, url: site.url };
const structuredData = { '@context': 'https://schema.org', '@graph': [website, organization] };
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(site.shareImage.width)} />
    <meta property="og:image:height" content={String(site.shareImage.height)} />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={site.themeColor} />

    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href={site.fontStylesheet} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6em 1.1em;
    border-radius: var(--radius-pill);
    background: var(--color-lime);
    color: var(--color-plum);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
