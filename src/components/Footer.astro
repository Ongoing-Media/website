---
import Logo from './Logo.astro';
import Brandmark from './Brandmark.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../config/site';
import { mainNav, routes } from '../config/routes';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-tone="brown">
  <div class="container grid">
    <div class="brand">
      <Logo variant="white" width={180} />
      <p class="tagline">{site.tagline}</p>
    </div>

    <address class="contact">
      <span class="label">visit</span>
      <span>{site.address.street}</span>
      <span>{site.address.postalCode} {site.address.city}</span>
      <span class="label">say hi</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="label">follow</span>
      <SocialLinks />
    </address>

    <nav aria-label="Footer">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={routes.privacy}>privacy</a></li>
      </ul>
    </nav>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}</p>
    <Brandmark class="footer-mark" />
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 8vw, 6rem) 2rem;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
  }

  .tagline {
    margin-top: 1.25rem;
    max-width: 28ch;
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .contact {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    font-style: normal;
  }

  .label {
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    color: var(--line);
  }

  .label:first-child {
    margin-top: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(3rem, 8vw, 5rem);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .bottom :global(.footer-mark) {
    width: 3rem;
    color: var(--fg);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
