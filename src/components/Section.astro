---
export type Tone = 'plum' | 'brown' | 'white' | 'cream' | 'lime';

interface Props {
  tone?: Tone;
  id?: string;
  class?: string;
  labelledby?: string;
  /** Ruimte aan de bovenkant: `small` direct onder de menubalk, `none` als vervolg op het blok erboven. */
  top?: 'default' | 'small' | 'none';
}

const { tone = 'white', id, class: className, labelledby, top = 'default' } = Astro.props;
---

<section id={id} data-tone={tone} aria-labelledby={labelledby} class:list={['section', `top-${top}`, className]}>
  <slot />
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--section-space);
  }

  .top-small {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .top-none {
    padding-top: 0;
  }
</style>
