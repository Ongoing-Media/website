---
import Brandmark from './Brandmark.astro';

interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  class?: string;
}

const { href, variant = 'solid', class: className } = Astro.props;
---

<a href={href} class:list={['button', variant, className]}>
  <span><slot /></span>
  <Brandmark class="button-mark" />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-height: 3rem;
    padding: 0.75em 1.4em 0.75em 1.6em;
    border-radius: var(--radius-pill);
    font-size: var(--text-base);
    font-style: italic;
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .solid {
    background: var(--accent);
    color: var(--bg);
  }

  .outline {
    border: 1.5px solid currentColor;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button :global(.button-mark) {
    width: 1.8em;
    transition: transform 0.3s var(--ease);
  }

  .button:hover :global(.button-mark) {
    transform: translateX(4px);
  }
</style>
