---
import Section, { type Tone } from './Section.astro';
import SplitHeading from './SplitHeading.astro';

// Bovenste blok van een binnenpagina: kop in deck-stijl plus korte introductie.
interface Props {
  tone: Tone;
  bold: string;
  italic?: string;
  eyebrow?: string;
  intro?: string;
}

const { tone, bold, italic, eyebrow, intro } = Astro.props;
---

<Section tone={tone} class="page-hero">
  <div class="container hero">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <SplitHeading level={1} size="3xl" bold={bold} italic={italic} stacked />
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</Section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(4rem, 10vw, 8rem);
  }

  .hero {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
