---
import type { ImageMetadata } from 'astro';
import Section, { type Tone } from './Section.astro';
import SplitHeading from './SplitHeading.astro';
import Photo from './Photo.astro';

// Bovenste blok van een binnenpagina: kop in deck-stijl plus korte introductie, eventueel met een foto ernaast.
interface Props {
  tone: Tone;
  bold: string;
  italic?: string;
  eyebrow?: string;
  intro?: string;
  image?: { src: ImageMetadata; alt: string };
}

const { tone, bold, italic, eyebrow, intro, image } = Astro.props;
---

<Section tone={tone} top="small">
  <div class:list={['container', 'hero', { 'with-image': image }]}>
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <SplitHeading level={1} size="3xl" bold={bold} italic={italic} stacked />
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </div>
    {image && <Photo src={image.src} alt={image.alt} sizes="(min-width: 60rem) 30vw, 80vw" priority class="hero-photo" />}
  </div>
</Section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
  }

  .text {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero :global(.hero-photo) {
    width: min(80%, 22rem);
    justify-self: end;
  }

  .hero :global(.hero-photo img) {
    width: 100%;
  }

  @media (min-width: 60rem) {
    .with-image {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }
</style>
