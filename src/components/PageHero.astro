---
import type { ImageMetadata } from 'astro';
import Section, { type Tone } from './Section.astro';
import SplitHeading from './SplitHeading.astro';
import Photo from './Photo.astro';

// Bovenste blok van een binnenpagina: kop in deck-stijl plus korte introductie, eventueel met een foto ernaast.
interface Props {
  tone: Tone;
  bold: string;
  italic?: string;
  eyebrow?: string;
  intro?: string;
  image?: { src: ImageMetadata; alt: string };
}

const { tone, bold, italic, eyebrow, intro, image } = Astro.props;
---

<Section tone={tone} top="small">
  <div class:list={['container', 'hero', { 'with-image': image }]}>
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <SplitHeading level={1} size="3xl" bold={bold} italic={italic} stacked />
      {intro && <p class="lead" data-motion="intro-late">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="hero-photo-wrap" data-motion="drift">
          <Photo src={image.src} alt={image.alt} sizes="(min-width: 60rem) 30vw, 80vw" priority motion="none" class="hero-photo" />
        </div>
      )
    }
  </div>
</Section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
  }

  .text {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero-photo-wrap {
    width: min(80%, 22rem);
    justify-self: end;
  }


  @media (min-width: 60rem) {
    .with-image {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }

    .with-image .text {
      padding-top: clamp(2rem, 5vw, 5rem);
    }
  }
</style>
