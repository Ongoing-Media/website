---
import { site } from '../config/site';
import instagram from '../assets/icons/instagram.svg?raw';
import tiktok from '../assets/icons/tiktok.svg?raw';
import linkedin from '../assets/icons/linkedin.svg?raw';

// Instagram, TikTok en LinkedIn met hun logo; gebruikt in de footer en op de contactpagina.
const icons: Record<(typeof site.socials)[number]['id'], string> = { instagram, tiktok, linkedin };

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['socials', className]}>
  {
    site.socials.map((social) => (
      <li>
        <a href={social.url} rel="noopener noreferrer" target="_blank">
          <span class="icon" aria-hidden="true" set:html={icons[social.id]} />
          <span class="visually-hidden">{social.label}: </span>
          {social.handle}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .icon {
    display: inline-flex;
    width: 1.05em;
    height: 1.05em;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
