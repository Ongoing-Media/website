---
import { site } from '../config/site';
import instagram from '../assets/icons/instagram.svg?raw';
import tiktok from '../assets/icons/tiktok.svg?raw';
import linkedin from '../assets/icons/linkedin.svg?raw';

// Instagram, TikTok en LinkedIn als klikbare iconen naast elkaar; gebruikt in de footer en op de contactpagina.
const icons: Record<(typeof site.socials)[number]['id'], string> = { instagram, tiktok, linkedin };

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['socials', 'list-reset', className]}>
  {
    site.socials.map((social) => (
      <li>
        <a href={social.url} rel="noopener noreferrer" target="_blank" aria-label={`${site.name} on ${social.label}`}>
          <span class="icon" aria-hidden="true" set:html={icons[social.id]} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    gap: 0.5rem;
  }

  /* Ruim klikvlak (min. 44px) rond een klein icoon, ook op mobiel goed te raken. */
  a {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.7rem;
    border-radius: 50%;
    transition: color 0.2s var(--ease);
  }

  li + li a {
    margin-left: 0;
  }

  a:hover {
    color: var(--accent);
  }

  .icon {
    display: inline-flex;
    width: 1.35rem;
    height: 1.35rem;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
