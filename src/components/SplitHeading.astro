---
// De kenmerkende kop uit het deck: een dik woord met een dun, schuin vervolg ("we move *beyond the feed*").
interface Props {
  bold: string;
  italic?: string;
  level?: 1 | 2 | 3;
  size?: 'xl' | '2xl' | '3xl';
  /** Het schuine deel op een nieuwe regel, iets ingesprongen. */
  stacked?: boolean;
  id?: string;
  class?: string;
}

const { bold, italic, level = 2, size = '2xl', stacked = false, id, class: className } = Astro.props;
const Tag = `h${level}` as const;
---

<Tag id={id} class:list={['split-heading', `size-${size}`, { stacked }, className]}>
  <span class="bold">{bold}</span>{italic && ' '}{italic && <span class="italic">{italic}</span>}
</Tag>

<style>
  .split-heading {
    font-weight: 700;
  }

  .size-xl {
    font-size: var(--text-xl);
  }

  .size-2xl {
    font-size: var(--text-2xl);
  }

  .size-3xl {
    font-size: var(--text-3xl);
  }

  .italic {
    font-style: italic;
    font-weight: 300;
    letter-spacing: -0.035em;
    color: var(--accent);
  }

  .stacked .italic {
    display: block;
    padding-left: 0.9em;
  }
</style>
