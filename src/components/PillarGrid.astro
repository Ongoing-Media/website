---
import { pillars } from '../data/services';

// De drie pijlers. `detailed` toont ook de losse diensten (voor de pagina "what we do").
interface Props {
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<ol class:list={['pillars', { detailed }]}>
  {
    pillars.map((pillar, index) => (
      <li class="pillar" id={detailed ? pillar.id : undefined}>
        <span class="number">0{index + 1}</span>
        <h3 class="title">
          {pillar.title} <span class="aside">{pillar.aside}</span>
        </h3>
        <p class="summary">{pillar.summary}</p>
        {detailed && (
          <ul class="services">
            {pillar.services.map((service) => (
              <li>{service}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  .pillar {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1.5px solid var(--line);
  }

  .number {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .title {
    font-size: var(--text-xl);
  }

  .aside {
    display: block;
    margin-top: 0.15em;
    font-size: 0.55em;
    font-style: italic;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .summary {
    color: var(--muted);
    max-width: 42ch;
  }

  .services {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .services li {
    display: flex;
    gap: 0.7em;
    align-items: baseline;
  }

  .services li::before {
    content: '';
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--line);
    transform: translateY(-0.05em);
  }

  @media (min-width: 60rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
