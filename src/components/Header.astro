---
import Logo from './Logo.astro';
import type { Tone } from './Section.astro';
import { mainNav, routes } from '../config/routes';
import { site } from '../config/site';
import { isActivePath } from '../lib/url';

interface Props {
  /** Kleur van de bovenkant van de pagina, zodat de balk er naadloos op aansluit. */
  tone: Tone;
}

const { tone } = Astro.props;
const isDark = tone === 'plum' || tone === 'brown';
const currentPath = Astro.url.pathname;
---

<header class="site-header" data-tone={tone}>
  <div class="container bar">
    <a href={routes.home} class="home-link" aria-label={`${site.name}, home`}>
      <Logo variant={isDark ? 'green' : 'black'} width={132} />
    </a>

    <!-- Op mobiel opent de knop het menu als "popover": werkt zonder extra JavaScript. -->
    <button class="menu-button" type="button" popovertarget="site-menu" aria-controls="site-menu">menu</button>

    <nav id="site-menu" class="menu" popover aria-label="Main">
      <button class="menu-close" type="button" popovertarget="site-menu" popovertargetaction="hide">
        close
      </button>
      <ul class="list-reset">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActivePath(currentPath, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
  }

  .home-link {
    display: block;
    padding-block: 0.5rem;
  }

  .menu-button,
  .menu-close {
    font: inherit;
    font-style: italic;
    color: inherit;
    background: none;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 0.45em 1.1em;
    min-height: 2.75rem;
    cursor: pointer;
  }

  .menu a {
    text-decoration: none;
  }

  .menu a[aria-current='page'] {
    color: var(--accent);
  }

  /* Mobiel: menu over het hele scherm. */
  .menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem var(--gutter) 2.5rem;
    border: 0;
    background: var(--color-plum);
    color: var(--color-cream);
    --accent: var(--color-lime);
  }

  .menu:popover-open {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .menu-close {
    align-self: flex-end;
  }

  .menu:popover-open ul {
    display: grid;
    gap: 0.4rem;
    font-size: clamp(2.75rem, 12vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  @media (min-width: 48rem) {
    .menu-button,
    .menu-close {
      display: none;
    }

    /* Desktop: gewoon een rij links in de balk (overschrijft het verbergen van de popover). */
    .menu,
    .menu:popover-open {
      display: block;
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      background: none;
      color: inherit;
      overflow: visible;
      --accent: inherit;
    }

    .menu ul,
    .menu:popover-open ul {
      display: flex;
      gap: clamp(1.25rem, 3vw, 2.5rem);
      font-size: var(--text-base);
      font-weight: 400;
      letter-spacing: 0;
    }

    .menu a {
      position: relative;
      padding-block: 0.4rem;
    }

    .menu a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--line);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s var(--ease);
    }

    .menu a:hover::after,
    .menu a[aria-current='page']::after {
      transform: scaleX(1);
    }
  }
</style>
