---
import Brandmark from './Brandmark.astro';
import type { CaseStudy } from '../data/cases';
import { caseRoute } from '../config/routes';

interface Props {
  item: CaseStudy;
  headingLevel?: 2 | 3;
}

const { item, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article class="case-card">
  <a href={caseRoute(item.slug)} class="link">
    <div class="visual" aria-hidden="true">
      <Brandmark class="visual-mark" />
      {item.placeholder && <span class="badge">example</span>}
    </div>
    <p class="client">{item.client}</p>
    <Heading class="title">{item.title}</Heading>
    <p class="summary">{item.summary}</p>
  </a>
</article>

<style>
  .link {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }

  .visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.6rem;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 15% 0%, rgb(255 104 9 / 0.4), transparent 60%),
      radial-gradient(90% 70% at 100% 100%, rgb(159 255 62 / 0.2), transparent 60%),
      var(--color-plum);
    color: var(--color-cream);
    transition: transform 0.5s var(--ease);
  }

  .link:hover .visual {
    transform: scale(0.98);
  }

  .visual :global(.visual-mark) {
    width: 4rem;
  }

  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.25em 0.8em;
    border-radius: var(--radius-pill);
    background: var(--color-lime);
    color: var(--color-plum);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .client {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .title {
    font-size: var(--text-xl);
  }

  .link:hover .title {
    color: var(--accent);
  }

  .summary {
    color: var(--muted);
    max-width: 40ch;
  }
</style>
