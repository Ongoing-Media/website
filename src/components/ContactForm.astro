---
import Brandmark from './Brandmark.astro';
import { routes } from '../config/routes';

// Netlify Forms leest dit formulier uit de gebouwde pagina. Spambescherming:
// een verborgen "honeypot"-veld (bots vullen het in, mensen niet) plus Netlify's eigen spamfilter.
const CONTACT_FORM_NAME = 'contact';
---

<form
  class="contact-form"
  name={CONTACT_FORM_NAME}
  method="POST"
  action={routes.contactThanks}
  data-netlify="true"
  netlify-honeypot="company-website"
>
  <input type="hidden" name="form-name" value={CONTACT_FORM_NAME} />

  <p class="honeypot" aria-hidden="true">
    <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field">
    <label for="contact-name">name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
  </div>

  <div class="field">
    <label for="contact-email">email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" />
  </div>

  <div class="field">
    <label for="contact-company">company <span class="optional">(optional)</span></label>
    <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="120" />
  </div>

  <div class="field">
    <label for="contact-message">message</label>
    <textarea id="contact-message" name="message" rows="6" required maxlength="5000"></textarea>
  </div>

  <p class="privacy">
    We only use your details to reply to your message. Read our <a href={routes.privacy}>privacy policy</a>.
  </p>

  <button type="submit" class="submit">
    <span>send message</span>
    <Brandmark class="submit-mark" />
  </button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.5rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .optional {
    font-style: italic;
  }

  input,
  textarea {
    width: 100%;
    font: inherit;
    font-size: max(16px, var(--text-base));
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1.5px solid var(--muted);
    border-radius: 0;
    padding: 0.6em 0;
    transition: border-color 0.2s var(--ease);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  input:focus-visible,
  textarea:focus-visible {
    box-shadow: 0 2px 0 0 var(--accent);
  }

  .privacy {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-height: 3rem;
    padding: 0.75em 1.4em 0.75em 1.6em;
    font: inherit;
    font-style: italic;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: transform 0.3s var(--ease);
  }

  .submit:hover {
    transform: translateY(-2px);
  }

  .submit :global(.submit-mark) {
    width: 1.8em;
  }
</style>
