---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

// Eén manier om foto's te tonen: moderne formaten (AVIF/WebP) en de juiste maat per scherm.
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Hoe breed de foto op het scherm wordt, zodat de browser het kleinste passende bestand kiest. */
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, widths = [360, 540, 720, 960, 1280, 1600], priority = false, class: className } = Astro.props;
// Nooit groter maken dan het origineel.
const usableWidths = [...new Set([...widths.filter((w) => w < src.width), Math.min(src.width, Math.max(...widths))])];
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={usableWidths}
  formats={['webp']}
  quality={72}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  pictureAttributes={{ class: className }}
/>
