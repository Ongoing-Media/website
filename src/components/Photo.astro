---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

// Eén manier om foto's te tonen: modern formaat (WebP) en de juiste maat per scherm.
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Hoe breed de foto op het scherm wordt, zodat de browser het kleinste passende bestand kiest. */
  sizes: string;
  widths?: number[];
  priority?: boolean;
  /** Animatie: `image` = onthullen bij scrollen, `zoom` = uitzoomen bij scrollen, `none` = stil. */
  motion?: 'image' | 'zoom' | 'none';
  /** `cover`: vult het hele vlak van de ouder (bijv. als achtergrond), bijsnijden waar nodig. */
  fit?: 'natural' | 'cover';
  class?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [360, 540, 720, 960, 1280, 1600],
  priority = false,
  motion = 'image',
  fit = 'natural',
  class: className,
} = Astro.props;
// Nooit groter maken dan het origineel.
const usableWidths = [...new Set([...widths.filter((w) => w < src.width), Math.min(src.width, Math.max(...widths))])];
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={usableWidths}
  formats={['webp']}
  quality={72}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  pictureAttributes={{
    class: ['photo-frame', fit === 'cover' && 'fit-cover', className].filter(Boolean).join(' '),
    'data-motion': motion === 'none' ? undefined : motion,
  }}
/>

<style is:global>
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .photo-frame.fit-cover,
  .photo-frame.fit-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
